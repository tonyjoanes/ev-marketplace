{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/schema.json",
  "stryker-config": {
    "project": "tests/EvMarketplace.Tests/EvMarketplace.Tests.csproj",
    "solution": "EvMarketplace.sln",
    "test-projects": [
      "tests/EvMarketplace.Tests/EvMarketplace.Tests.csproj"
    ],
    "mutate": [
      "src/EvMarketplace.Domain/**/*.cs",
      "src/EvMarketplace.Infrastructure/Services/**/*.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    },
    "reporters": [
      "html",
      "progress",
      "cleartext",
      "json"
    ],
    "dashboard": {
      "enabled": false
    },
    "concurrency": 4,
    "ignore-mutations": [
      "string"
    ],
    "timeout-ms": 60000,
    "mutation-level": "complete"
  }
}
